# Perfil local: levanta los tres nodos PostgreSQL y MongoDB en este equipo.
# En el despliegue distribuido usa ags, jalisco o zacatecas según el equipo.
COMPOSE_PROFILES=local

POSTGRES_USER=uniselecciones
POSTGRES_PASSWORD=replace_with_a_local_secret
POSTGRES_DB=uniselecciones

# API FastAPI (genera una clave aleatoria local de 32 caracteres o más).
API_DB_USER=uniselecciones_api
API_DB_PASSWORD=replace_with_an_api_database_secret
JWT_SECRET=replace_with_a_local_jwt_secret_at_least_32_chars
ACCESS_TOKEN_MINUTES=60
API_DB_HOST=127.0.0.1

MONGO_INITDB_ROOT_USERNAME=uniselecciones_admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_another_local_secret

# En local, publica solo en la computadora. Para acceso por VPN, usa la IP VPN
# del nodo y configura el firewall para aceptar conexiones solo desde la VPN.
DB_BIND_IP=127.0.0.1
PG_AGS_PORT=5432
PG_JALISCO_PORT=5433
PG_ZACATECAS_PORT=5434
MONGO_PORT=27017

# Seguridad de PostgreSQL (generar llaves aleatorias de 32 bytes).
APP_REGION_NODO=AGS
APP_CRIPTO_KEY=replace_with_a_64_character_random_key
APP_MATRICULA_KEY=replace_with_a_64_character_random_key
APP_SEUDONIMO_KEY=replace_with_a_64_character_random_key
APP_ENFORCE_CP=false

# PostgreSQL TLS
API_DB_SSLMODE=verify-full
API_DB_SSLROOTCERT=certs/postgres/ags/ca.crt
